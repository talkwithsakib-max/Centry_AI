---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../sections/Hero.astro';
import Stats from '../sections/Stats.astro';
import HowItWorks from '../sections/HowItWorks.astro';
import Features from '../sections/Features.astro';
import InboxScanner from '../sections/InboxScanner.astro';
import ZombieAlert from '../sections/ZombieAlert.astro';
import AppPreview from '../sections/AppPreview.astro';
import Privacy from '../sections/Privacy.astro';
import Pricing from '../sections/Pricing.astro';
import FAQ from '../sections/FAQ.astro';
import GetTheApp from '../sections/GetTheApp.astro';
import Waitlist from '../sections/Waitlist.astro';
import Footer from '../sections/Footer.astro';
---

<BaseLayout>
  <main id="main">
    <Hero />
    <Stats />
