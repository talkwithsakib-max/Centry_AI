---
/** Figma component "Price tag" — red pill, e.g. "-$15.99". `scale` matches scaled instances. */
interface Props {
  price: string;
  scale?: number;
  class?: string;
  style?: string;
}
const { price, scale = 1, class: className, style = '' } = Astro.props;
---

<span class:list={['price-tag', className]} style={`--u:${scale}px;${style}`}>{price}</span>

<style>
  .price-tag {
    display: inline-flex;
    align-items: flex-start;
    padding: calc(4 * var(--u)) calc(9 * var(--u));
    border-radius: var(--radius-pill);
    background: linear-gradient(180deg, var(--color-zombie) 0%, var(--color-zombie) 100%);
    box-shadow:
      0 calc(4 * var(--u)) calc(10 * var(--u)) calc(-2 * var(--u)) rgb(var(--zombie-rgb) / 0.28),
      inset 0 calc(1 * var(--u)) 0 0 rgba(255, 255, 255, 0.35);
    color: #fff;
    font-weight: var(--fw-bold);
    font-size: calc(13 * var(--u));
    line-height: normal;
    white-space: nowrap;
  }
  :global([data-theme='dark']) .price-tag {
    box-shadow:
      0 calc(4 * var(--u)) calc(10 * var(--u)) calc(-2 * var(--u)) rgb(var(--zombie-rgb) / 0.28),
      inset 0 calc(1 * var(--u)) 0 0 rgba(255, 255, 255, 0.1);
  }
</style>
