---
/**
 * Floating "liquid glass" tab bar for the redesigned app screens (styles: styles/app-screen.css).
 * 2026-11-14, after Mobbin (Photoroom, Superpower): four tabs in a glass pill — icon over
 * label, the active one sits in a glass capsule — and Ask (the AI) as its own round glass
 * button beside the pill.
 * Previous versions: ./_legacy/AppTabBar.pre-orb.astro, ./_legacy/AppTabBar.orb-rejected.astro
 */
interface Props {
  active?: 'home' | 'subs' | 'calendar' | 'ask' | 'insights' | 'none';
}
const { active = 'subs' } = Astro.props;
---

<nav class="tabbar" aria-hidden="true">
  <span class="pill">
    <span class:list={['tab', active === 'home' && 'on']}>
      <svg viewBox="0 0 20 20">
        <path d="M3.6 8.6 10 3.4l6.4 5.2v6.6a2 2 0 0 1-2 2H5.6a2 2 0 0 1-2-2Z" class="fill" />
        <path d="M8.2 17.2v-3.6a1.8 1.8 0 0 1 3.6 0v3.6" class="cut" />
      </svg>
      <span>Home</span>
    </span>
    <span class:list={['tab', active === 'subs' && 'on']}>
      <svg viewBox="0 0 20 20">
        <rect x="5.5" y="3" width="9" height="2.2" rx="1.1" class="soft" />
        <rect x="3" y="6.6" width="14" height="10.4" rx="3" class="fill" />
        <path d="M6.3 10.4h4.2M6.3 13.2h2.4" class="cut" />
      </svg>
      <span>Subs</span>
    </span>
    <span class:list={['tab', active === 'calendar' && 'on']}>
      <svg viewBox="0 0 20 20">
        <rect x="3" y="4.2" width="14" height="12.8" rx="3.2" class="fill" />
        <path d="M3 8.4h14M7 2.8v2.6M13 2.8v2.6" class="cut" />
        <circle cx="7.2" cy="12.4" r="0.95" class="dotf" />
        <circle cx="10.6" cy="12.4" r="0.95" class="dotf" />
      </svg>
      <span>Calendar</span>
    </span>
    <span class:list={['tab', active === 'insights' && 'on']}>
      <svg viewBox="0 0 20 20">
        <path d="M4.5 16.5v-4.2M10 16.5V7.5M15.5 16.5V3.8" />
      </svg>
      <span>Insights</span>
    </span>
  </span>

  <span class:list={['ask', active === 'ask' && 'on']}>
    <svg viewBox="0 0 20 20">
      <defs>
        <linearGradient id="ask-g" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#c9c5ff" />
          <stop offset=".55" stop-color="#8b83ff" />
          <stop offset="1" stop-color="#5246e8" />
        </linearGradient>
      </defs>
      <path fill="url(#ask-g)" d="M9.2 2.4c.6 4 2.4 5.9 6.6 6.8-4.2.9-6 2.8-6.6 6.8-.6-4-2.4-5.9-6.6-6.8 4.2-.9 6-2.8 6.6-6.8Z" />
      <path fill="url(#ask-g)" d="M15.4 12.6c.24 1.5.9 2.2 2.3 2.5-1.4.3-2.06 1-2.3 2.5-.24-1.5-.9-2.2-2.3-2.5 1.4-.3 2.06-1 2.3-2.5Z" />
    </svg>
  </span>
</nav>
<span class="home-ind"></span>
