---
/**
 * Figma "Hero visual (Gaia pile)" — the 1424×1008 scene behind the hero copy.
 * Layer order matches Figma exactly. Rendered at design size and scaled as a
 * whole (see Hero.astro) so the composition never changes.
 */
import SubTile from '../components/brand/SubTile.astro';
import PriceTag from '../components/brand/PriceTag.astro';
import CancelBadge from '../components/brand/CancelBadge.astro';
import mist from '../assets/textures/hero-mint-mist-blur.webp';
import pileSmoke from '../assets/textures/hero-pile-smoke-blur.webp';
import phoneGlow from '../assets/textures/hero-phone-glow.webp';
import ticks from '../assets/icons/hero/beam-ticks.svg?url';
import flareCentre from '../assets/icons/hero/flare-centre.svg?url';
import flareHit from '../assets/icons/hero/flare-tile-hit.svg?url';
import flareLeft from '../assets/icons/hero/flare-left.svg?url';
import wisp1 from '../assets/icons/hero/wisp-1.svg?url';
import wisp2 from '../assets/icons/hero/wisp-2.svg?url';
import wisp3 from '../assets/icons/hero/wisp-3.svg?url';
import wisp4 from '../assets/icons/hero/wisp-4.svg?url';
import wisp5 from '../assets/icons/hero/wisp-5.svg?url';
import wisp1d from '../assets/icons/hero/wisp-1-dark.svg?url';
import wisp2d from '../assets/icons/hero/wisp-2-dark.svg?url';
import wisp3d from '../assets/icons/hero/wisp-3-dark.svg?url';
import wisp4d from '../assets/icons/hero/wisp-4-dark.svg?url';
import wisp5d from '../assets/icons/hero/wisp-5-dark.svg?url';
import { fallingTiles, pile as fullPile, TILE, BEAM_Y, type FloatingTile } from '../data/hero-tiles';

/* Cleaner hero (user, 2026-11-11):
 * - the icons that used to rest around the headline are gone;
 * - the pile is thinner: the top rows are dropped and the next row is halved
 *   (72 → 50 icons), so fewer icons fall on load and the heap sits lower.
 * The Figma data file stays untouched; the filter lives here. */
const floatingTiles: FloatingTile[] = [];
let keptPrev = true;
let thin = 0;
const pile = fullPile.filter((p) => {
  if (p.badge) return keptPrev; // a ✕ badge rides with the icon just before it
  keptPrev = p.cy >= 930 || (p.cy >= 900 && thin++ % 2 === 0);
  return keptPrev;
});

const half = TILE / 2;
const at = (cx: number, cy: number, rot = 0) => `left:${cx - half}px;top:${cy - half}px;--rot:${rot}deg`;

/* ---------- Load intro (desktop, ~3s; approved 2026-11-09) ----------
 * Every icon drops in from above the card. The scan line opens from the phone
 * outwards at BEAM_AT; each icon exists twice — a colour copy clipped above the
 * line and a cancelled copy clipped below it — so it turns grey exactly where
 * it crosses. The last frame is the static Figma composition. */
const BEAM_AT = 1.0; // s, line opens
const CROSS_MIN = BEAM_AT + 0.1; // no icon may reach the line before it exists
const fallFor = (cy: number) => {
  const dist = cy + 70; // start just above the card
  return { dist, t: 1.15 * Math.sqrt(dist / 1100) };
};
// Icons that stay in the hero glide in and slow smoothly to rest (no overshoot, no spin).
const glideFor = (cy: number) => {
  const dist = cy + 70;
  return { dist, t: 1.0 + 0.4 * Math.min(1, dist / 1100) };
};
// Pseudo-random but stable per index (SSR output stays deterministic).
const rnd = (i: number, salt = 1) => {
  const x = Math.sin(i * 12.9898 + salt * 78.233) * 43758.5453;
  return x - Math.floor(x);
};
const spin = (i: number) => `${((rnd(i, 3) - 0.5) * 50).toFixed(1)}deg`;

/* Easing curves as [x1, y1, x2, y2] — must match the CSS below. */
type Ease = [number, number, number, number];
const FALL: Ease = [0.55, 0, 1, 0.45]; // gravity (pile)
const GLIDE: Ease = [0.22, 1, 0.36, 1]; // smooth arrival (icons that stay)
const bez = (p1: number, p2: number, u: number) => 3 * (1 - u) * (1 - u) * u * p1 + 3 * (1 - u) * u * u * p2 + u * u * u;
// Time fraction at which the curve's progress reaches f.
const timeAtProgress = (f: number, e: Ease) => {
  for (let i = 1; i <= 400; i++) {
    const u = i / 400;
    if (bez(e[1], e[3], u) >= f) return bez(e[0], e[2], u);
  }
  return 1;
};
interface Motion {
  dist: number;
  t: number;
  ease: Ease;
  /** share of the run spent travelling the full distance (rest = bounce) */
  impact: number;
}
const pileMotion = (cy: number): Motion => ({ ...fallFor(cy), ease: FALL, impact: 0.84 });
const glideMotion = (cy: number): Motion => ({ ...glideFor(cy), ease: GLIDE, impact: 1 });
// When a point `edge` px below the tile centre reaches the line.
const reachTime = (cy: number, d: number, m: Motion, edge: number) => {
  const f = Math.min(1, Math.max(0, (BEAM_Y - (cy + edge - m.dist)) / m.dist));
  return d + m.impact * m.t * timeAtProgress(f, m.ease);
};
// Delay pushed back if the tile would reach the line before the line exists.
const delayFor = (cy: number, d: number, m: Motion) => {
  if (cy + half <= BEAM_Y) return d;
  const c = reachTime(cy, d, m, half);
  return c < CROSS_MIN ? d + (CROSS_MIN - c) : d;
};
const dropVars = (cy: number, d: number, i: number, m: Motion) =>
  `--from:${(-m.dist).toFixed(0)}px;--t:${m.t.toFixed(3)}s;--d:${delayFor(cy, d, m).toFixed(3)}s;--spin:${spin(i)}`;
// Spark on the line when the tile's centre crosses it.
const sparkAt = (cx: number, cy: number, d: number, m: Motion) =>
  `left:${(cx - 60).toFixed(1)}px;--at:${reachTime(cy, delayFor(cy, d, m), m, 0).toFixed(3)}s`;

/* One shared arrival timeline (user, 2026-11-09): every icon comes to rest at an
 * evenly spaced moment between ARRIVE_FROM and ARRIVE_TO, so arrivals form a steady
 * rhythm. Floating icons and the three greys are spread evenly among the pile
 * landings (bottom row first); the two icons on the line settle last, together
 * with the final pile icon. "Arrive" = end of the icon's animation. */
const ARRIVE_FROM = 1.4; // s — first pile icons must still cross the line after it opens
const ARRIVE_TO = 2.45; // s
const pileTileCount = pile.filter((p) => !p.badge).length;
const extras = [
  ...floatingTiles.map((t, i) => ({ kind: 'float' as const, i, cy: t.cy, key: rnd(i, 11) })),
  ...fallingTiles.map((t, i) => ({ kind: 'grey' as const, i, cy: t.cy, key: rnd(i + 50, 11) })),
].sort((a, b) => a.key - b.key); // mix left / right / greys
const total = pileTileCount + extras.length;
const arriveAt = (k: number) => ARRIVE_FROM + ((ARRIVE_TO - ARRIVE_FROM) * k) / (total - 1);
// Evenly spaced slots for the extras; the pile fills the rest in its own order.
const extraSlot = new Map<number, (typeof extras)[number]>();
extras.forEach((e, j) => extraSlot.set(Math.round(((j + 0.5) * total) / extras.length - 0.5), e));
const floatArrive: number[] = [];
const greyArrive: number[] = [];
const pileArrive: number[] = [];
for (let k = 0; k < total; k++) {
  const e = extraSlot.get(k);
  if (!e) pileArrive.push(arriveAt(k));
  else if (e.kind === 'float') floatArrive[e.i] = arriveAt(k);
  else greyArrive[e.i] = arriveAt(k);
}

// Floating (stay above the line): glide to rest; bob starts from rest afterwards.
const floatDrop = (i: number, cy: number) => {
  const m = glideMotion(cy);
  return dropVars(cy, Math.max(0, floatArrive[i] - m.t), i, m);
};
// Pile: falls with gravity, lands with a small bounce.
let tileIdx = -1;
let lastDrop = '';
const pileSparks: string[] = [];
let pileEnd = 0; // s — when the last pile icon has finished landing
const pileDrops = pile.map((p) => {
  if (p.badge) return lastDrop; // a badge rides with the tile just before it
  tileIdx++;
  const m = pileMotion(p.cy);
  const base = pileArrive[tileIdx] - m.t;
  lastDrop = dropVars(p.cy, base, 100 + tileIdx, m);
  pileSparks.push(sparkAt(p.cx, p.cy, base, m));
  pileEnd = Math.max(pileEnd, delayFor(p.cy, base, m) + m.t);
  return lastDrop;
});
// The two icons that used to sit on the line now ride on the phone's top corners
// (Hero.astro, user 2026-11-12); the three greys take their evenly spaced slots.
const mids = [...fallingTiles];
const midBase = (t: { cy: number }, i: number) => greyArrive[i] - glideMotion(t.cy).t;
const midDrops = mids.map((t, i) => dropVars(t.cy, midBase(t, i), 40 + i, glideMotion(t.cy)));
const midSparks = fallingTiles.map((t, i) => sparkAt(t.cx, t.cy, midBase(t, i), glideMotion(t.cy)));
// The line exists only while icons fall: it fades out once the pile has landed.
const beamOff = (Math.max(pileEnd, ...midDrops.map((_, i) => midBase(mids[i], i) + glideMotion(mids[i].cy).t)) + 0.25).toFixed(2);
// Per-tile bob timing — deterministic so SSR output is stable.
const bob = (i: number) => `--bob-dur:${(5.2 + ((i * 7) % 6) * 0.5).toFixed(1)}s;--bob-delay:-${((i * 1.37) % 5).toFixed(2)}s;--bob-amp:${4 + (i % 3)}px`;
// Dark theme: same wisps stroked #2e334d (navy, 2026-11-14 rebrand; was #334542).
const wisps = [
  { src: wisp1, dark: wisp1d, style: 'left:-13.95px;width:1437.95px' },
  { src: wisp2, dark: wisp2d, style: 'left:0;width:1424px' },
  { src: wisp3, dark: wisp3d, style: 'left:0;width:1437.95px' },
  { src: wisp4, dark: wisp4d, style: 'left:0;width:1430.98px' },
  { src: wisp5, dark: wisp5d, style: 'left:-13.95px;width:1437.95px' },
];
---

<div class="scene" aria-hidden="true" data-smoke-root style={`--beam-off:${beamOff}s`}>
  <img class="mist only-light" src={mist.src} alt="" />
  <img class="mist only-light bleed-copy smoke-mirror-l" src={mist.src} alt="" />
  <img class="mist only-light bleed-copy smoke-mirror-r" src={mist.src} alt="" />
  <!-- Dark: the mist shape as "Dark smoke" (60%) -->
  <span class="mist dark-smoke only-dark" style={`--mask:url(${mist.src})`}></span>
  <span class="mist dark-smoke only-dark bleed-copy smoke-mirror-l" style={`--mask:url(${mist.src})`}></span>
  <span class="mist dark-smoke only-dark bleed-copy smoke-mirror-r" style={`--mask:url(${mist.src})`}></span>
  <!-- animated smoke (WebGL, scripts/smoke.ts); replaces the two layers above once drawing -->
  <canvas class="mist smoke-gl" data-smoke data-box="1504,1088" data-src={mist.src}></canvas>

  <!-- Scan beam (back) -->
  <div class="beam">
    <span class="wake"></span>
    <span class="halo"></span>
    <span class="inner-glow"></span>
    <span class="echo"></span>
    <img class="ticks" src={ticks} alt="" />
    <img class="flare" style="left:497px;top:148px;width:430px;height:24px" src={flareCentre} alt="" />
    <img class="flare" style="left:940px;top:148px;width:160px;height:24px" src={flareHit} alt="" />
    <img class="flare" style="left:355px;top:148px;width:130px;height:24px" src={flareLeft} alt="" />
    <!-- Dark: white-cored flares (radial, 5px blur) -->
    <span class="flare-d only-dark" style="left:502px;--c:rgba(255,255,255,.55);--m:rgb(var(--brand-rgb) / .33);width:420px"></span>
    <span class="flare-d only-dark" style="left:945px;--c:rgba(255,255,255,.75);--m:rgb(var(--brand-rgb) / .45);width:150px"></span>
    <span class="flare-d only-dark" style="left:360px;--c:rgba(255,255,255,.4);--m:rgb(var(--brand-rgb) / .24);width:120px"></span>
    <span class="core"></span>
    <!-- intro: the whole line flares bright as it opens, then settles -->
    <span class="flash-line"></span>
  </div>
  <!-- intro: a blast at each side of the phone as the line bursts out -->
  <span class="blast blast-l"></span>
  <span class="blast blast-r"></span>
  <span class="ring ring-l"></span>
  <span class="ring ring-r"></span>
  <!-- intro: the line's two ends are glowing orbs racing out to the edges -->
  <span class="orb orb-l"></span>
  <span class="orb orb-r"></span>

  <!-- Figma "Phone glow" rendered exactly (ellipse, 22%, 90px blur) — tools/preblur.mjs -->
  <img class="phone-glow" src={phoneGlow.src} alt="" />

  <!-- Active subscriptions (burst) — alpha-masked to fade into the hero top -->
  <div class="active">
    {
      floatingTiles.map((t, i) => (
        <div class="float" style={`${bob(i)};${floatDrop(i, t.cy)};left:${t.cx - half}px;top:${t.cy - half}px`}>
          <SubTile brand={t.brand} size={TILE} class="tile" style={`left:0;top:0;--rot:${t.rot}deg`} />
          {t.tag && (
            <PriceTag
              price={t.tag.price}
              scale={0.847}
              class="tag"
              style={`left:${t.tag.cx - t.cx + half}px;top:${t.tag.cy - t.cy + half}px;--rot:${t.tag.rot}deg`}
            />
          )}
        </div>
      ))
    }
  </div>

  <!-- Falling (cancelled): two tiles split by the beam + three falling greys -->
  <div class="falling">
    <div class="half below">
      {fallingTiles.map((t, i) => (
        <SubTile brand={t.brand} state="cancelled" size={TILE} class="tile drop mid" style={`${at(t.cx, t.cy, t.rot)};opacity:${t.opacity};${midDrops[i]}`} />
      ))}
    </div>
    <div class="half above">
      {fallingTiles.map((t, i) => (
        <SubTile brand={t.brand} size={TILE} class="tile drop mid" style={`${at(t.cx, t.cy, t.rot)};${midDrops[i]}`} />
      ))}
    </div>
    {midSparks.map((sp) => <span class="spark" style={sp}></span>)}
  </div>

  <!-- Scan beam (front pass) -->
  <div class="beam-front">
    <span class="bf-glow"></span>
    <span class="bf-line"></span>
  </div>

  <img class="pile-smoke only-light" src={pileSmoke.src} alt="" />
  <img class="pile-smoke only-light bleed-copy smoke-mirror-l" src={pileSmoke.src} alt="" />
  <img class="pile-smoke only-light bleed-copy smoke-mirror-r" src={pileSmoke.src} alt="" />
  <span class="pile-smoke dark-smoke only-dark" style={`--mask:url(${pileSmoke.src})`}></span>
  <span class="pile-smoke dark-smoke only-dark bleed-copy smoke-mirror-l" style={`--mask:url(${pileSmoke.src})`}></span>
  <span class="pile-smoke dark-smoke only-dark bleed-copy smoke-mirror-r" style={`--mask:url(${pileSmoke.src})`}></span>
  <canvas class="pile-smoke smoke-gl" data-smoke data-box="1504,1088" data-src={pileSmoke.src}></canvas>

  <!-- Cancelled pile (+ a copy each side, shown only when the card is wider than 1424px) -->
  {[0, -1424, 1424].map((dx) => (
  <div class:list={['pile', dx !== 0 && 'bleed-copy']} style={`transform:translateX(${dx}px)`}>
    <div class="half below">
      {
        pile.map((p, i) =>
          p.badge ? (
            <CancelBadge class="badge drop land" style={`left:${p.cx - 15}px;top:${p.cy - 15}px;${pileDrops[i]}`} />
          ) : (
            <SubTile brand={p.brand} state="cancelled" size={TILE} class="tile drop land" style={`${at(p.cx, p.cy, p.rot)};${pileDrops[i]}`} />
          )
        )
      }
    </div>
    <!-- colour copies: only visible while an icon is still above the line -->
    <div class="half above pile-colour">
      {pile.map((p, i) => !p.badge && <SubTile brand={p.brand} size={TILE} class="tile drop land" style={`${at(p.cx, p.cy, p.rot)};${pileDrops[i]}`} />)}
    </div>
    <!-- intro: a spark on the line where each icon is cancelled -->
    {pileSparks.map((sp) => <span class="spark" style={sp}></span>)}
  </div>
  ))}

  <!-- Ghost wisps (front of pile) -->
  {[0, -1424, 1424].map((dx) => (
    <div class:list={['wisps', dx !== 0 && 'bleed-copy']} style={`transform:translateX(${dx}px)`}>
      {wisps.map((w) => <img class="only-light" src={w.src} alt="" style={w.style} />)}
      {wisps.map((w) => <img class="only-dark" src={w.dark} alt="" style={w.style} />)}
    </div>
  ))}

</div>

<style>
  .scene {
    position: absolute;
    inset: 0;
    width: 1424px;
    height: 1008px;
    pointer-events: none;
  }
  .scene > * {
    position: absolute;
  }
  /* --px/--py/--pr: hover nudge from scripts/pile-hover.ts (0 at rest) */
  .scene :global(.tile) {
    position: absolute;
    transform: translate(var(--px, 0px), var(--py, 0px)) rotate(calc(var(--rot) + var(--pr, 0deg)));
  }

  /* Mint mist: 40%, 6px blur, oversized 40px */
  .scene {
    --b: var(--bleed, 0px);
  }
  .scene :global(.mist),
  .scene :global(.pile-smoke) {
    left: -40px;
    top: -40px;
    width: 1504px;
    height: 1088px;
    max-width: none;
    object-fit: cover;
  }
  .scene .smoke-gl {
    left: calc(-40px - var(--b));
    width: calc(1504px + 2 * var(--b));
  }
  .scene :global(.mist) {
    opacity: 0.4;
  }
  /* Wide screens: the smoke stays at exact Figma size in the centre; mirrored copies
     continue it into the extra width on each side (edges meet pixel-for-pixel). */
  .scene .smoke-mirror-l {
    transform: translateX(-1504px) scaleX(-1);
  }
  .scene .smoke-mirror-r {
    transform: translateX(1504px) scaleX(-1);
  }
  .scene :global(.pile-smoke) {
    opacity: 0.85;
  }
  /* Animated smoke canvas: hidden until its first frame, then it replaces the still layers */
  .smoke-gl {
    display: none;
  }
  .scene.smoke-gl-on .smoke-gl {
    display: block;
  }
  .scene.smoke-gl-on .mist:not(.smoke-gl),
  .scene.smoke-gl-on .pile-smoke:not(.smoke-gl) {
    display: none !important;
  }
  /* Dark smoke (user, 2026-11-11/12): on the clean black it must read as soft
     clouds drifting, not a grey overlay — hero mist 30% (Figma 60%); the pile sits
     on black, with only a faint wisp behind it (20%) */
  :global([data-theme='dark']) .scene .mist.smoke-gl,
  .scene .mist.dark-smoke {
    opacity: 0.3;
  }
  :global([data-theme='dark']) .scene .pile-smoke.smoke-gl,
  .scene .pile-smoke.dark-smoke {
    opacity: 0.2;
  }

  /* ---- Scan beam ---- */
  .beam {
    left: calc(-1 * var(--b));
    top: 595px;
    width: calc(1424px + 2 * var(--b));
    height: 240px;
    /* the line exists only during the load intro (user, 2026-11-12) */
    visibility: hidden;
  }
  .beam > * {
    position: absolute;
    left: 0;
    width: 100%;
  }
  /* flares keep their Figma positions relative to the 1424px design */
  .beam > .flare {
    margin-left: var(--b);
  }
  .wake {
    top: 50px;
    height: 110px;
    background: linear-gradient(180deg, rgb(var(--brand-rgb) / 0) 0%, rgb(var(--brand-rgb) / 0.06) 70%, rgb(var(--brand-rgb) / 0.16) 100%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 18%, #000 82%, transparent 100%);
  }
  .halo {
    top: 136px;
    height: 48px;
    filter: blur(10px);
    background: linear-gradient(
      90deg,
      rgb(var(--brand-rgb) / 0) 0%,
      rgb(var(--brand-rgb) / 0.112) 12%,
      rgb(var(--brand-rgb) / 0.32) 50%,
      rgb(var(--brand-rgb) / 0.112) 88%,
      rgb(var(--brand-rgb) / 0) 100%
    );
    animation: beam-pulse 3.2s var(--ease-in-out) infinite alternate;
  }
  .inner-glow {
    top: 155px;
    height: 10px;
    filter: blur(2px);
    background: linear-gradient(
      90deg,
      rgb(var(--brand-rgb) / 0) 0%,
      rgb(var(--brand-rgb) / 0.225) 10%,
      rgb(var(--brand-rgb) / 0.75) 50%,
      rgb(var(--brand-rgb) / 0.225) 90%,
      rgb(var(--brand-rgb) / 0) 100%
    );
    animation: beam-pulse 3.2s var(--ease-in-out) infinite alternate;
  }
  .echo {
    top: 165px;
    height: 1px;
    background: linear-gradient(
      90deg,
      rgb(var(--brand-rgb) / 0) 0%,
      rgb(var(--brand-rgb) / 0.168) 20%,
      rgb(var(--brand-rgb) / 0.28) 50%,
      rgb(var(--brand-rgb) / 0.168) 80%,
      rgb(var(--brand-rgb) / 0) 100%
    );
  }
  .ticks {
    top: 168px;
    height: 4px;
  }
  .beam > .flare {
    width: auto;
  }
  .core {
    top: 158.75px;
    height: 2.5px;
    background: linear-gradient(
      90deg,
      rgb(var(--brand-rgb) / 0) 0%,
      rgb(var(--brand-rgb) / 0.75) 10%,
      var(--color-brand) 50%,
      rgb(var(--brand-rgb) / 0.75) 90%,
      rgb(var(--brand-rgb) / 0) 100%
    );
  }
  .flare-d {
    position: absolute;
    top: 153px;
    height: 14px;
    margin-left: var(--b);
    background: radial-gradient(closest-side, var(--c) 0%, var(--m) 45%, rgb(var(--brand-rgb) / 0) 100%);
    filter: blur(5px);
  }

  /* ---- Dark theme beam: brighter, white core (Figma "Home 2 — Dark") ---- */
  :global([data-theme='dark']) .wake {
    background: linear-gradient(180deg, rgb(var(--brand-rgb) / 0) 0%, rgb(var(--brand-rgb) / 0.07) 70%, rgb(var(--brand-rgb) / 0.2) 100%);
  }
  :global([data-theme='dark']) .halo {
    background: linear-gradient(
      90deg,
      rgb(var(--brand-rgb) / 0) 0%,
      rgb(var(--brand-rgb) / 0.13) 12%,
      rgb(var(--brand-rgb) / 0.38) 50%,
      rgb(var(--brand-rgb) / 0.13) 88%,
      rgb(var(--brand-rgb) / 0) 100%
    );
  }
  :global([data-theme='dark']) .inner-glow {
    background: linear-gradient(
      90deg,
      rgb(var(--brand-rgb) / 0) 0%,
      rgb(var(--brand-rgb) / 0.25) 10%,
      rgb(var(--brand-rgb) / 0.85) 50%,
      rgb(var(--brand-rgb) / 0.25) 90%,
      rgb(var(--brand-rgb) / 0) 100%
    );
  }
  :global([data-theme='dark']) .echo {
    background: linear-gradient(
      90deg,
      rgb(var(--brand-rgb) / 0) 0%,
      rgb(var(--brand-rgb) / 0.21) 20%,
      rgb(var(--brand-rgb) / 0.35) 50%,
      rgb(var(--brand-rgb) / 0.21) 80%,
      rgb(var(--brand-rgb) / 0) 100%
    );
  }
  :global([data-theme='dark']) .beam > .flare {
    display: none;
