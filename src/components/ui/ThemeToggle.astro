---
/**
 * Light / dark switch. Not in Figma (the file has separate light and dark
 * frames); styled to match the navbar links and the footer language pill.
 *   variant="icon" — 36px round icon button (navbar)
 *   variant="pill" — icon + "Dark mode" / "Light mode" (footer bottom row)
 * The icon shows the mode you switch TO: moon in light, sun in dark.
 */
interface Props {
  variant?: 'icon' | 'pill';
  class?: string;
}
const { variant = 'icon', class: className } = Astro.props;
---

<button
  class:list={['theme-toggle', variant, className]}
  type="button"
  aria-label="Switch to dark mode"
  data-theme-toggle
>
  <svg class="ico moon" viewBox="0 0 20 20" aria-hidden="true" width="18" height="18">
    <path
      d="M16.2 12.35A6.75 6.75 0 0 1 7.65 3.8a6.75 6.75 0 1 0 8.55 8.55Z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linejoin="round"></path>
  </svg>
  <svg class="ico sun" viewBox="0 0 20 20" aria-hidden="true" width="18" height="18">
    <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
      <circle cx="10" cy="10" r="3.4"></circle>
      <path d="M10 1.9v1.7M10 16.4v1.7M1.9 10h1.7M16.4 10h1.7M4.27 4.27l1.2 1.2M14.53 14.53l1.2 1.2M4.27 15.73l1.2-1.2M14.53 5.47l1.2-1.2"></path>
    </g>
  </svg>
  {variant === 'pill' && <span class="label" data-theme-label>Dark mode</span>}
</button>

<script>
  import { initThemeToggle } from '../../scripts/theme';
  initThemeToggle();
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    color: var(--color-link);
    border-radius: var(--radius-pill);
    transition:
      background var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }
  .theme-toggle:hover {
    background: var(--color-fill-1);
    color: var(--color-ink);
  }
  .theme-toggle:active {
    transform: translateY(1px);
  }
  .icon {
    width: 36px;
    height: 36px;
  }
  .pill {
    gap: 6px;
    height: 28px;
    padding: 0 12px 0 10px;
    background: var(--color-fill-1);
    font-size: 13px;
    font-weight: var(--fw-medium);
    letter-spacing: -0.1px;
    color: var(--color-ink-2);
  }
  .pill .ico {
    width: 14px;
    height: 14px;
  }
  .sun {
    display: none;
  }
  :global([data-theme='dark']) .sun {
    display: block;
  }
  :global([data-theme='dark']) .moon {
    display: none;
  }
</style>
