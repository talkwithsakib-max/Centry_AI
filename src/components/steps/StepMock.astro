---
/** The white mock card inside each How-it-works visual (Figma "Mock"). */
import SubTile from '../brand/SubTile.astro';
import gmail from '../../assets/icons/gmail.svg?url';
import icloud from '../../assets/icons/icloud.svg?url';
import lock from '../../assets/icons/lock.svg?url';
import arrow from '../../assets/icons/arrow-up-right-sm.svg?url';

interface Props {
  step: 1 | 2 | 3;
}
const { step } = Astro.props;
---

<div class:list={['mock', `s${step}`]}>
  {
    step === 1 && (
      <>
        <p class="m-title">Connect your inbox</p>
        <div class="provider" style="top:48px">
          <span class="p-icon"><img src={gmail} alt="" /></span>
          <span class="p-name">Gmail</span>
          <span class="p-meta">you@gmail.com</span>
          <span class="pill ok">✓ Connected</span>
        </div>
        <div class="provider" style="top:108px">
          <span class="p-icon"><img src={icloud} alt="" /></span>
          <span class="p-name">iCloud Mail</span>
          <span class="p-meta">Not connected</span>
          <span class="pill dark">Connect</span>
        </div>
        <p class="note">
          <img src={lock} alt="" width="12" height="14" />
          Read-only · emails never stored
        </p>
      </>
    )
  }
  {
    step === 2 && (
      <>
        <p class="m-title">9 subscriptions found</p>
        <span class="pill ok total"><span data-count="86.94" data-format="${int}.{dec}/mo" data-at="0.55" data-for="1.1">$86.94/mo</span></span>
        {[
          { b: 'netflix', name: 'Netflix', meta: 'Renews Nov 5', price: '$15.49', top: 53 },
          { b: 'spotify', name: 'Spotify', meta: 'Renews Nov 8', price: '$9.99', top: 101 },
          { b: 'headspace', name: 'Headspace', meta: 'Last used 91 days ago', price: '$12.99', top: 149, zombie: true },
        ].map((r, i) => (
          <>
            <SubTile brand={r.b as 'netflix'} size={34} style={`position:absolute;left:16px;top:${r.top}px`} />
            <span class="r-name" style={`top:${r.top - 1}px`}>{r.name}</span>
            <span class:list={['r-meta', r.zombie && 'danger']} style={`top:${r.top + 18}px`}>
              {r.meta}
            </span>
            <span class="r-price" style={`top:${r.top - 1}px`}>{r.price}</span>
            {r.zombie && <span class="pill zombie">Zombie 99</span>}
            {i < 2 && <span class="r-div" style={`top:${r.top + 41}px`} />}
          </>
        ))}
      </>
    )
  }
  {
    step === 3 && (
      <>
        <SubTile brand="headspace" size={44} style="position:absolute;left:16px;top:16px" />
        <p class="c-title">Cancel Headspace?</p>
        <p class="c-meta">$12.99/mo · last used 91 days ago</p>
        <span class="c-btn">
          Open cancel page <img src={arrow} alt="" width="13" height="13" />
        </span>
        <p class="c-save">✓&nbsp;&nbsp;You’ll save <span data-count="155.88" data-format="${int}.{dec}" data-at="0.95" data-for="1.1">$155.88</span> a year</p>
        <p class="c-keep">Keep subscription</p>
      </>
    )
  }
</div>

<style>
  .mock {
    position: absolute;
    left: 104px;
    top: 117px;
    width: 380px;
    height: 200px;
    border-radius: 20px;
    background: var(--color-surface);
    box-shadow: var(--elevation-medium);
    white-space: nowrap;
    color: var(--color-ink);
  }
  .mock.s1 {
    top: 110px;
    height: 214px;
  }
  .mock > * {
    position: absolute;
  }
  .m-title {
    left: 16px;
    top: 16px;
    font-size: 15px;
    font-weight: var(--fw-semibold);
    letter-spacing: -0.2px;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-pill);
    font-size: 12px;
    font-weight: var(--fw-semibold);
  }
  .pill.ok {
    padding: 4px 10px;
    background: var(--color-success-soft);
    color: var(--color-success-text);
  }
  .pill.dark {
    padding: 5px 12px;
    background: var(--color-ink);
    color: var(--color-page);
  }
  .provider {
    left: 16px;
    width: 348px;
    height: 52px;
    border-radius: 14px;
    background: var(--color-fill-ios);
  }
  .provider > * {
    position: absolute;
  }
  .p-icon {
    left: 9px;
    top: 9px;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: var(--color-surface-raised);
  }
  .p-icon img {
    width: 34px;
    height: 34px;
  }
  .p-name {
    left: 52px;
    top: 9px;
    font-size: 14px;
    font-weight: var(--fw-semibold);
    letter-spacing: -0.2px;
  }
  .p-meta {
    left: 52px;
    top: 28px;
    font-size: 12px;
    letter-spacing: -0.2px;
    color: var(--color-ink-3);
  }
  .provider .pill {
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
  }
  .note {
    left: 16px;
    top: 180px;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: var(--fw-medium);
    color: var(--color-ink-3);
  }
  .total {
    right: 16px;
    top: 15px;
  }
  .r-name,
  .r-price {
    font-size: 14px;
    font-weight: var(--fw-semibold);
    letter-spacing: -0.2px;
  }
  .r-name {
    left: 60px;
  }
  .r-price {
    right: 16px;
  }
  .r-meta {
    left: 60px;
    font-size: 12px;
    letter-spacing: -0.2px;
    color: var(--color-ink-3);
  }
  .r-meta.danger {
    color: var(--color-zombie-text);
  }
  .r-div {
    left: 60px;
    width: 304px;
    height: 0.5px;
    background: var(--color-hairline);
  }
  .pill.zombie {
    right: 16px;
    top: 166px;
    padding: 1px 6px;
    font-size: 11px;
    background: var(--color-danger-soft);
    color: var(--color-zombie-text);
  }
  .c-title {
    left: 72px;
    top: 18px;
    font-size: 16px;
    font-weight: var(--fw-semibold);
    letter-spacing: -0.2px;
  }
  .c-meta {
    left: 72px;
    top: 40px;
    font-size: 12px;
    letter-spacing: -0.2px;
    color: var(--color-ink-3);
  }
  .c-btn {
    left: 16px;
    top: 82px;
    width: 348px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border-radius: 14px;
    background: var(--gradient-btn);
    color: var(--color-btn-ink);
    font-size: 14px;
    font-weight: var(--fw-semibold);
  }
  .c-save,
  .c-keep {
    left: 0;
    right: 0;
    text-align: center;
    font-size: 13px;
    letter-spacing: -0.2px;
  }
  .c-save {
    top: 140px;
    font-weight: var(--fw-semibold);
    color: var(--color-success-text);
  }
  .c-keep {
    top: 166px;
    font-weight: var(--fw-medium);
    color: var(--color-ink-3);
  }
  /* Dark (Figma): secondary mock text lifts to #9aa3be */
  :global([data-theme='dark']) .p-meta,
  :global([data-theme='dark']) .note,
  :global([data-theme='dark']) .r-meta:not(.danger),
  :global([data-theme='dark']) .c-meta {
    color: var(--color-ink-2);
  }
  :global([data-theme='dark']) .note :global(img) {
    filter: brightness(1.5);
  }

  /* ---- Motion (user brief 2026-11-10) ----
     When a step card is open (and its section has scrolled in), the mock's pieces
     come in top to bottom: rows slide in, pills/buttons pop, text rises. --row is
     set from each piece's position by scripts/steps.ts. Counts: steps.ts. */
  :global(.fx [data-reveal].is-in .step[data-open]) .mock > :global(*) {
    animation: mock-rise 0.6s cubic-bezier(0.22, 1, 0.36, 1) calc(420ms + var(--row, 0) * 85ms) backwards;
  }
  :global(.fx [data-reveal].is-in .step[data-open]) .mock > :global(.provider),
  :global(.fx [data-reveal].is-in .step[data-open]) .mock > :global(.tile) {
    animation-name: mock-slide;
  }
  :global(.fx [data-reveal].is-in .step[data-open]) .mock > :global(.pill),
  :global(.fx [data-reveal].is-in .step[data-open]) .mock > :global(.c-btn),
  :global(.fx [data-reveal].is-in .step[data-open]) .provider > .pill {
    animation: mock-pop 0.55s cubic-bezier(0.34, 1.45, 0.64, 1) calc(560ms + var(--row, 0) * 85ms) backwards;
  }
  :global(.fx [data-reveal].is-in .step[data-open]) .mock > .zombie {
    animation:
      mock-pop 0.55s cubic-bezier(0.34, 1.45, 0.64, 1) calc(560ms + var(--row, 0) * 85ms) backwards,
      zombie-glow 2.2s ease-out calc(900ms + var(--row, 0) * 85ms) backwards;
  }
  @keyframes mock-rise {
    from {
      opacity: 0;
      translate: 0 10px;
    }
  }
  @keyframes mock-slide {
    from {
      opacity: 0;
      translate: -18px 0;
    }
  }
  @keyframes mock-pop {
    from {
      opacity: 0;
      scale: 0.6;
    }
  }
  @keyframes zombie-glow {
    from {
      box-shadow: 0 0 0 0 rgb(var(--zombie-rgb) / 0);
    }
    30% {
      box-shadow: 0 0 14px 2px rgb(var(--zombie-rgb) / 0.4);
    }
    to {
      box-shadow: 0 0 0 0 rgb(var(--zombie-rgb) / 0);
    }
  }
</style>
