---
/**
 * Nav "Features ▾" — a disclosure button controlling a glass panel of the
 * four features. Behaviour lives in src/scripts/dropdown.ts.
 */
import chevron from '../../assets/icons/chevron-down.svg?url';
import { features } from '../../data/features';
---

<div class="dropdown" data-dropdown>
  <button
    class="trigger nav-link"
    type="button"
    aria-expanded="false"
    aria-controls="features-menu"
    data-dropdown-trigger
  >
    Features
    <img class="chevron" src={chevron} alt="" width="10" height="10" />
  </button>
  <div class="panel" id="features-menu" data-dropdown-panel hidden>
    <ul class="list">
      {
        features.map((f) => (
          <li>
            <a class="item" href={f.href} data-dropdown-item>
              <span class="name">{f.name}</span>
              <span class="desc">{f.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<script>
  import { initDropdowns } from '../../scripts/dropdown';
  initDropdowns();
</script>

<style>
  .dropdown {
    position: relative;
  }
  .trigger {
    gap: 4px;
  }
  .chevron {
    width: 10px;
    height: 10px;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .trigger[aria-expanded='true'] {
    background: var(--color-fill-1);
    color: var(--color-ink);
  }
  .trigger[aria-expanded='true'] .chevron {
    transform: rotate(180deg);
  }

  .panel {
    position: absolute;
    top: calc(100% + 14px);
    left: 50%;
    width: 340px;
    padding: 6px;
    border-radius: 20px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.92) 0%, rgba(255, 255, 255, 0.8) 100%);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow:
      0 30px 60px -20px rgba(28, 36, 70, 0.1),
      0 14px 32px -8px rgba(28, 36, 70, 0.14),
      0 4px 10px -2px rgba(28, 36, 70, 0.08),
      0 1px 2px 0 rgba(28, 36, 70, 0.08),
      inset 0 1px 0 0 var(--hl-100);
    transform-origin: top center;
    opacity: 0;
    transform: translate(-50%, -4px) scale(0.98);
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  .panel[data-open] {
    opacity: 1;
    transform: translate(-50%, 0) scale(1);
  }
  /* invisible bridge so the hover path from trigger to panel isn't broken */
  .panel::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -14px;
    height: 14px;
  }
  .item {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 10px 12px;
    border-radius: 14px;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .item:hover,
  .item:focus-visible {
    background: var(--color-fill-1);
  }
  .item:focus-visible {
    outline-offset: -2px;
  }
  .name {
    font-size: 14px;
    font-weight: var(--fw-semibold);
    letter-spacing: -0.15px;
    color: var(--color-ink);
  }
  .desc {
    font-size: 12px;
    line-height: 16px;
    letter-spacing: -0.1px;
    color: var(--color-ink-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* Dark glass (matches the dark navbar) */
  :global([data-theme='dark']) .panel {
    background: linear-gradient(180deg, rgba(22, 24, 29, 0.92) 0%, rgba(22, 24, 29, 0.8) 100%);
    box-shadow:
      0 30px 60px -20px rgba(0, 0, 0, 0.3),
      0 14px 32px -8px rgba(0, 0, 0, 0.42),
      0 4px 10px -2px rgba(0, 0, 0, 0.24),
      0 1px 2px 0 rgba(0, 0, 0, 0.24),
      inset 0 1px 0 0 rgba(255, 255, 255, 0.1);
  }
</style>
