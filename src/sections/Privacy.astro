---
/** Figma "Privacy" (661:17998): dark card with glass padlock, three fact cards, Limited Use note. */
import IconBadge from '../components/ui/IconBadge.astro';
import Fit from '../components/ui/Fit.astro';
import smokeA from '../assets/textures/panel-smoke-a-mask.webp';
import mintGlow from '../assets/icons/privacy/mint-glow.svg?url';
import mintCore from '../assets/icons/privacy/mint-glow-core.svg?url';
import padlock from '../assets/icons/privacy/glass-padlock.svg?url';
import lock from '../assets/icons/badges/lock.svg?url';
import receipt from '../assets/icons/badges/receipt.svg?url';
import shield from '../assets/icons/badges/shield-fact.svg?url';
import { links, linkAttrs } from '../config/links';

const facts = [
  { icon: lock, title: 'Read-only access', body: 'CentryAI asks for gmail.readonly. It can’t send, delete or change a single email.' },
  { icon: receipt, title: 'Receipts, not conversations', body: 'We only scan billing and receipt emails. Your personal messages are skipped.' },
  { icon: shield, title: 'Never stored, never sold', body: 'Email content isn’t kept on our servers, shared with anyone, or used to train AI.' },
];
---

<section class="privacy" id="privacy" aria-labelledby="privacy-title">
  <div class="container">
    <div class="card">
      <div class="art" aria-hidden="true" data-smoke-root>
        <Fit w={1240} h={560}>
          <span class="smoke" style={`--mask:url(${smokeA.src})`}></span>
          <!-- rising smoke (WebGL, scripts/smoke.ts); replaces the layer above once drawing -->
          <canvas class="smoke-gl" data-smoke data-fit="fill" data-tint="dark" data-src={smokeA.src}></canvas>
          <img class="glow" src={mintGlow} alt="" />
          <img class="core" src={mintCore} alt="" />
          <img class="lock" src={padlock} alt="" />
        </Fit>
      </div>
      <div class="copy">
        <p class="eyebrow">Privacy</p>
        <h2 class="title" id="privacy-title">Your inbox stays yours.</h2>
        <p class="lede">
          CentryAI reads only subscription receipts, with read-only Gmail access.<br class="br" /> We never sell your data,
          never train AI on it, and never store your emails.
        </p>
      </div>
    </div>

    <ul class="facts">
      {
        facts.map((f) => (
          <li class="fact">
            <IconBadge src={f.icon} />
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </li>
        ))
      }
    </ul>

    <p class="note">
      CentryAI’s use of Google user data follows the Google API Services User Data Policy, including the Limited Use
      requirements.&nbsp; <a {...linkAttrs(links.privacyPolicy)}>Read our privacy policy →</a>
    </p>
  </div>
</section>

<style>
  .privacy {
    padding: 120px 0;
  }
  .container {
    max-width: calc(1240px + 2 * var(--gutter));
  }
  .card {
    position: relative;
    height: 560px;
    border-radius: var(--radius-section);
    overflow: hidden;
    background: linear-gradient(155.7deg, #1a1a1d 0%, #09090a 71.43%);
    box-shadow: var(--elevation-large);
    display: grid;
    place-items: center;
  }
  .art {
    position: absolute;
    left: 50%;
    top: 0;
    width: 1240px;
    transform: translateX(-50%);
  }
  .art :global(.fit-stage) > * {
    position: absolute;
    max-width: none;
  }
  .smoke {
    left: -30px;
    top: 3.31px;
    width: 1300px;
    height: 596.69px;
    opacity: 0.8;
    background: linear-gradient(90deg, #334542 0%, #293838 50%, #334047 100%);
    mask-image: var(--mask);
    mask-size: 1300px 596.69px;
    mask-repeat: no-repeat;
    -webkit-mask-image: var(--mask);
    -webkit-mask-size: 1300px 596.69px;
    -webkit-mask-repeat: no-repeat;
  }
  .smoke-gl {
    display: none;
    left: -30px;
    top: 3.31px;
    width: 1300px;
    height: 596.69px;
    opacity: 0.8;
  }
  .art.smoke-gl-on .smoke-gl {
    display: block;
  }
  .art.smoke-gl-on .smoke {
    display: none;
  }
  .glow {
    left: -70px;
    top: 300px;
    width: 1380px;
    height: 640px;
  }
  .core {
    left: 270px;
    top: 430px;
    width: 700px;
    height: 340px;
  }
  .lock {
    left: 362px;
    top: 18px;
    width: 516px;
    height: 628px;
  }
  .copy {
    position: relative;
    margin-top: 110px;
    text-align: center;
    padding-inline: 24px;
  }
  .eyebrow {
    font-size: 13px;
    font-weight: var(--fw-semibold);
    letter-spacing: 1.8px;
    line-height: 16px;
    text-transform: uppercase;
    color: #3ccf96;
  }
  .title {
    margin-top: 16px;
    font-size: clamp(32px, 2rem + 1.2vw, 48px);
    font-weight: var(--fw-semibold);
    line-height: 1.04;
    letter-spacing: -0.028em;
    color: #f5f5f7;
  }
  .lede {
    margin-top: 20px;
    font-size: 17px;
    line-height: 26px;
    color: #a1a1a6;
  }
  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    box-shadow:
      inset 0 -3px 6px 0 rgba(28, 36, 70, 0.04),
      inset 0 1px 0 0 var(--hl-100);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 20px;
  }
  .fact {
    min-height: 188px;
    padding: 28px;
    border-radius: 24px;
    background: var(--color-surface);
    box-shadow: var(--elevation-medium);
  }
  .fact h3 {
    margin-top: 20px;
    font-size: 17px;
    font-weight: var(--fw-semibold);
    letter-spacing: -0.17px;
  }
  .fact p {
    margin-top: 6px;
    font-size: 15px;
    line-height: 23px;
    color: var(--color-ink-2);
  }
  .note {
    margin-top: 32px;
    text-align: center;
    font-size: 13px;
    color: var(--color-ink-2);
  }
  .note a {
    font-weight: var(--fw-medium);
    color: var(--color-ink);
    white-space: nowrap;
    border-radius: 4px;
    transition: color var(--dur-base) var(--ease-out);
  }
  .note a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 1023px) {
    .privacy {
      padding: 88px 0;
    }
    .card {
      height: 480px;
    }
    .facts {
      grid-template-columns: minmax(0, 1fr);
    }
    .fact {
      min-height: 0;
    }
  }
  @media (max-width: 767px) {
    .privacy {
      padding: 72px 0;
    }
    .card {
      height: 440px;
      border-radius: 24px;
    }
    .art {
      width: 900px;
    }
    .copy {
      margin-top: 60px;
    }
    .br {
      display: none;
    }
  }
</style>
