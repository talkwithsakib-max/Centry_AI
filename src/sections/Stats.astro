---
/** Figma "Stats" (431:3682) — "Small leaks. Big savings." + four stat cards. */
import SectionHeading from '../components/ui/SectionHeading.astro';
import SubTile from '../components/brand/SubTile.astro';
import IconBadge from '../components/ui/IconBadge.astro';
import shield from '../assets/icons/badges/shield.svg?url';
import type { Brand } from '../components/brand/brands';

const stack: { brand: Brand; left: number; rot: number }[] = [
  { brand: 'netflix', left: 0, rot: 8 },
  { brand: 'spotify', left: 36, rot: -4 },
  { brand: 'prime-video', left: 72, rot: 4 },
  { brand: 'duolingo', left: 108, rot: -7 },
];
---

<section class="stats" aria-labelledby="stats-title" data-reveal>
  <div class="container">
    <SectionHeading eyebrow="By the numbers" line1="Small leaks." line2="Big savings." inline align="center" id="stats-title" />

    <ul class="cards">
      <li class="card" data-r style="--rd:0ms">
        <div class="visual stack fx-loop" aria-hidden="true">
          {stack.map((t, k) => <SubTile brand={t.brand} size={40} style={`position:absolute;left:${t.left}px;top:2px;transform:rotate(${t.rot}deg);--k:${k}`} />)}
          <span class="chip" data-r="scale" style="position:absolute;left:158px;top:9px;--rd:620ms">+86</span>
        </div>
        <p class="num glow-mint"><span data-count="90" data-at="0.25" data-for="1.3">90</span><span class="mint">+</span></p>
        <p class="label">Services supported</p>
        <p class="desc">Netflix to Notion, auto-detected.</p>
      </li>

      <li class="card" data-r style="--rd:90ms">
        <div class="chips">
          <span class="chip danger" data-r="scale" style="--rd:380ms">Zombie spend</span>
          <span class="chip soft" data-r="scale" style="--rd:440ms"><span>↑ <span data-count="12" data-format="{n}%" data-at="0.45" data-for="1">12%</span> this year</span></span>
        </div>
        <p class="num glow-red"><span class="dim">$</span><span data-count="47" data-at="0.35" data-for="1.3">47</span></p>
        <p class="label">Avg. monthly waste found</p>
        <p class="desc">Per user, in forgotten renewals.</p>
      </li>

      <li class="card" data-r style="--rd:180ms">
        <div class="chips">
          {['EN', 'ES', 'FR', 'DE'].map((c, k) => <span class="chip" data-r="scale" style={`--rd:${470 + k * 55}ms`}>{c}</span>)}
          <span class="chip mint-chip" data-r="scale" style="--rd:700ms">+14</span>
        </div>
        <p class="num"><span data-count="18" data-at="0.45" data-for="1.1">18</span></p>
        <p class="label">Languages supported</p>
        <p class="desc">Receipts read in any inbox language.</p>
      </li>

      <li class="card dark" data-r style="--rd:270ms">
        <div class="chips shield-row">
          <span class="shield fx-loop" data-r="scale" style="--rd:560ms"><IconBadge src={shield} /></span>
          <span class="chip on-dark" data-r="scale" style="--rd:640ms">Email-only scan</span>
        </div>
        <p class="num">0</p>
        <p class="label">Bank accounts required</p>
        <p class="desc">We read receipts. Never your bank.</p>
      </li>
    </ul>
  </div>
</section>

<style>
  /* Figma: 715px tall; top area leaves room for the hero phone that overlaps it */
  .stats {
    position: relative;
    padding-top: 255px;
    padding-bottom: 72px;
    background: var(--color-page);
  }
  .container {
    max-width: calc(1244px + 2 * var(--gutter));
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin-top: 70px;
  }
  .card {
    position: relative;
    height: 236px;
    padding: 0 28px;
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--elevation-large);
  }
  .card.dark {
    background: var(--gradient-dark-card);
  }
  /* Dark theme: the shield card matches the others (Figma) */
  :global([data-theme='dark']) .card.dark {
    background: var(--color-surface);
  }
  .visual {
    position: absolute;
    left: 28px;
    top: 28px;
    width: 170px;
    height: 48px;
  }
  .chips {
    position: absolute;
    left: 28px;
    top: 34px;
    display: flex;
    gap: 6px;
    flex-wrap: nowrap;
  }
  .shield-row {
    top: 30px;
    align-items: center;
    gap: 10px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    padding: 6px 11px;
    border-radius: var(--radius-pill);
    background: var(--color-fill-2);
    font-size: 13px;
    font-weight: var(--fw-semibold);
    color: var(--color-ink-1);
    white-space: nowrap;
  }
  .chips .chip {
    background: var(--color-fill-1);
  }
  .chip.danger {
    background: var(--color-danger-soft);
    color: var(--color-danger);
  }
  .chip.soft {
    font-weight: var(--fw-medium);
    color: var(--color-ink-2);
  }
  .chip.mint-chip {
    background: var(--color-mint-soft);
    color: var(--color-mint-ink);
  }
  .chip.on-dark {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    font-weight: var(--fw-medium);
  }
  .num {
    position: absolute;
    left: 26px;
    top: 84px;
    font-size: 60px;
    font-weight: var(--fw-bold);
    letter-spacing: -0.045em;
    line-height: 72px;
    color: var(--color-ink);
  }
  .mint {
    color: var(--color-mint-2);
  }
  .dim {
    color: var(--color-ink-4);
  }
  .label {
    position: absolute;
    left: 28px;
    top: 164px;
    font-size: 16px;
    font-weight: var(--fw-semibold);
    letter-spacing: -0.2px;
    color: var(--color-ink-1);
  }
  .desc {
    position: absolute;
    left: 28px;
    right: 28px;
    top: 188px;
    font-size: 14px;
    letter-spacing: -0.1px;
    color: var(--color-ink-2);
  }
  .dark .num,
  .dark .label {
    color: #fff;
  }
  .dark .desc {
    color: rgba(255, 255, 255, 0.55);
  }

  /* ---- Motion (user brief 2026-11-10): counts in reveal.ts; here the glows and
     the gentle idle movement. Paused off-screen via .fx-loop. ---- */
  :global(.fx) .stack :global(.tile) {
    animation: fx-bob 3.6s ease-in-out calc(1.2s + var(--k) * 0.35s) infinite;
  }
  :global(.fx) .shield {
    display: inline-flex;
    animation: shield-breathe 3.2s ease-in-out 1.4s infinite;
  }
  @keyframes shield-breathe {
    50% {
      scale: 1.06;
      filter: drop-shadow(0 0 8px rgba(63, 227, 166, 0.45));
    }
  }
  /* important numbers: a soft glow flares once the count lands, then stays faint */
  :global(.fx) .stats:global(.is-in) .glow-mint {
    animation: glow-mint 2.4s ease-out 1.5s both;
  }
  :global(.fx) .stats:global(.is-in) .glow-red {
    animation: glow-red 2.4s ease-out 1.6s both;
  }
  @keyframes glow-mint {
    from {
      text-shadow: 0 0 0 rgba(63, 227, 166, 0);
    }
    25% {
      text-shadow: 0 0 26px rgba(63, 227, 166, 0.55);
    }
    to {
      text-shadow: 0 0 18px rgba(63, 227, 166, 0.2);
    }
  }
  @keyframes glow-red {
    from {
      text-shadow: 0 0 0 rgba(255, 59, 48, 0);
    }
    25% {
      text-shadow: 0 0 26px rgba(255, 59, 48, 0.45);
    }
    to {
      text-shadow: 0 0 18px rgba(255, 59, 48, 0.16);
    }
  }

  @media (max-width: 1199px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* compact hero: the phone overhangs ~242px (tablet) / ~274px (mobile) */
  @media (max-width: 1023px) {
    .stats {
      padding-top: 296px;
    }
  }
  @media (max-width: 767px) {
    .stats {
      padding-top: 318px;
      padding-bottom: 56px;
    }
    .cards {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
      margin-top: 40px;
    }
  }
</style>
