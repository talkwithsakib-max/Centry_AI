---
/**
 * Figma "Badge / Google Play" and "Badge / App Store (coming soon)".
 * size: 'lg' = hero (51px tall, 21px label), 'md' = footer (44px, 18px label).
 * The App Store badge is never a link while it says "Coming soon".
 */
import googlePlay from '../../assets/icons/google-play.svg?url';
import apple from '../../assets/icons/apple.svg?url';
import { links, linkAttrs } from '../../config/links';

interface Props {
  store: 'google' | 'apple';
  size?: 'lg' | 'md';
  class?: string;
}
const { store, size = 'lg', class: className } = Astro.props;
---

{
  store === 'google' ? (
    <a class:list={['badge', 'google', size, className]} {...linkAttrs(links.googlePlay)}>
      <img class="icon" src={googlePlay} alt="" />
      <span class="label">
        <span class="small">GET IT ON</span>
        <span class="big">Google Play</span>
      </span>
    </a>
  ) : (
    <div class:list={['badge', 'apple', size, className]} aria-label="App Store — coming soon">
      <img class="icon" src={apple} alt="" />
      <span class="label">
        <span class="small">Coming soon on the</span>
        <span class="big">App Store</span>
      </span>
    </div>
  )
}

<style>
  .badge {
    --s: 1;
    display: inline-flex;
    align-items: center;
    gap: calc(10px * var(--s));
    padding: calc(8px * var(--s)) calc(18px * var(--s)) calc(8px * var(--s)) calc(14px * var(--s));
    border-radius: calc(12px * var(--s));
    white-space: nowrap;
    flex: none;
  }
  .md {
    --s: 0.857;
  }
  .google {
    color: #fff;
    background: var(--gradient-dark-button);
    box-shadow:
      0 1px 2px 0 rgba(28, 36, 70, 0.08),
      0 4px 10px -3px rgba(28, 36, 70, 0.1),
      inset 0 1px 0 0 var(--hl-35);
    transition:
      background var(--dur-base) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  @media (hover: hover) {
    .google:hover {
      background: var(--gradient-dark-button-hover);
    }
  }
  .google:active {
    transform: translateY(1px);
  }
  .apple {
    gap: calc(9px * var(--s));
    color: var(--color-ink);
    background: var(--gradient-control);
    box-shadow: var(--elevation-control);
  }
  /* Dark (Figma): Google Play turns white, App Store graphite */
  :global([data-theme='dark']) .google {
    color: var(--color-btn-ink);
    box-shadow:
      0 1px 2px 0 rgba(0, 0, 0, 0.4),
      0 4px 10px -3px rgba(0, 0, 0, 0.35),
      inset 0 1px 0 0 rgba(255, 255, 255, 0.1);
  }
  :global([data-theme='dark']) .apple .icon {
    filter: brightness(0) invert(0.96);
  }
  :global([data-theme='dark']) .apple .small {
    color: #a8a8b0;
  }
  .icon {
    flex: none;
    height: calc(28px * var(--s));
    width: calc(26px * var(--s));
  }
  .apple .icon {
    width: calc(24px * var(--s));
  }
  .label {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: normal;
  }
  .small {
    font-size: calc(10px * var(--s));
    font-weight: var(--fw-medium);
    letter-spacing: calc(0.3px * var(--s));
    margin-bottom: calc(-2px * var(--s));
  }
  .apple .small {
    letter-spacing: calc(0.1px * var(--s));
  }
  .big {
    font-size: calc(21px * var(--s));
    font-weight: var(--fw-semibold);
    letter-spacing: calc(-0.21px * var(--s));
  }
</style>
