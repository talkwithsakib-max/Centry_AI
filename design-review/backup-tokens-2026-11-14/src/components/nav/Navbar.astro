---
/**
 * Figma "Navbar" (419:2457): 846×52 glass pill, centred 20px below the hero top.
 * Below 900px it collapses to brand · Download · menu button (MobileMenu).
 */
import CentryMark from '../brand/CentryMark.astro';
import FeaturesDropdown from './FeaturesDropdown.astro';
import MobileMenu from './MobileMenu.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';
import arrow from '../../assets/icons/arrow-up-right.svg?url';
import { anchors, links, linkAttrs } from '../../config/links';
---

<header class="nav-wrap">
  <nav class="navbar" aria-label="Main">
    <div class="left">
      <a class="brand" href={anchors.top} aria-label="CentryAI home">
        <CentryMark size={24} />
        <span class="wordmark">CentryAI</span>
      </a>
    </div>

    <ul class="links">
      <li><FeaturesDropdown /></li>
      <li><a class="nav-link" href={anchors.howItWorks}>How it works</a></li>
      <li><a class="nav-link" href={anchors.pricing}>Pricing</a></li>
      <li><a class="nav-link" href={anchors.faq}>FAQ</a></li>
    </ul>

    <div class="right">
      <ThemeToggle class="nav-theme" />
      <a class="nav-link login" {...linkAttrs(links.logIn)}>Log in</a>
      <a class="download" {...linkAttrs(links.downloadApp)}>
        <span class="download-label">Download<span class="download-app"> app</span></span>
        <span class="arrow-chip"><img src={arrow} alt="" width="28" height="28" /></span>
      </a>
      <MobileMenu />
    </div>
  </nav>
</header>

<style>
  .nav-wrap {
    position: absolute;
    top: 20px;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding-inline: 16px;
    pointer-events: none;
  }
  .navbar {
    pointer-events: auto;
    position: relative;
    width: 846px;
    max-width: 100%;
    height: 52px;
    display: grid;
    grid-template-columns: minmax(max-content, 1fr) auto minmax(max-content, 1fr);
    align-items: center;
    padding: 0 6px 0 18px;
    border-radius: var(--radius-pill);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.88) 0%, rgba(255, 255, 255, 0.72) 100%);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow:
      0 30px 60px -20px rgba(28, 36, 70, 0.1),
      0 14px 32px -8px rgba(28, 36, 70, 0.14),
      0 4px 10px -2px rgba(28, 36, 70, 0.08),
      0 1px 2px 0 rgba(28, 36, 70, 0.08),
      inset 0 1px 0 0 var(--hl-100);
  }
  .left,
  .right {
    min-width: 0;
    height: 40px;
    display: flex;
    align-items: center;
  }
  .right {
    justify-content: flex-end;
    gap: 2px;
  }
  .right :global(.download) {
    margin-left: 4px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 6.3px;
    border-radius: 8px;
  }
  .wordmark {
    font-size: 16.2px;
    font-weight: var(--fw-semibold);
    letter-spacing: -0.162px;
    color: var(--color-ink);
  }
  .links {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  /* Shared nav link (also used by FeaturesDropdown trigger) */
  :global(.nav-link) {
    display: inline-flex;
    align-items: center;
    padding: 7px 12px;
    border-radius: var(--radius-pill);
    font-size: 14px;
    font-weight: var(--fw-medium);
    letter-spacing: -0.15px;
    line-height: 17px;
    color: var(--color-link);
    white-space: nowrap;
    transition:
      background var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }
  :global(.nav-link:hover),
  :global(.nav-link:focus-visible) {
    background: var(--color-fill-1);
    color: var(--color-ink);
  }
  :global(.nav-link:active) {
    transform: translateY(1px);
  }

  .download {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 4px 4px 16px;
    border-radius: var(--radius-pill);
    background: var(--gradient-nav-button);
    box-shadow:
      0 1px 2px 0 rgba(0, 0, 0, 0.12),
      0 6px 14px -4px rgba(0, 0, 0, 0.16),
      inset 0 1px 0 0 rgba(255, 255, 255, 0.22);
    color: var(--color-btn-ink);
    font-size: 14px;
    font-weight: var(--fw-semibold);
    letter-spacing: -0.15px;
    line-height: 17px;
    white-space: nowrap;
    transition:
      background var(--dur-base) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  @media (hover: hover) {
    .download:hover {
      background: var(--gradient-nav-button-hover);
    }
  }
  .download:active {
    transform: translateY(1px);
  }
  .arrow-chip {
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background: var(--color-mint);
    box-shadow: inset 0 0.875px 0 0 var(--hl-50);
    flex: none;
  }

  /* ---------- Dark (Figma "Home 2 — Dark" navbar) ---------- */
  :global([data-theme='dark']) .navbar {
    background: linear-gradient(180deg, rgba(22, 24, 29, 0.88) 0%, rgba(22, 24, 29, 0.72) 100%);
    box-shadow:
      0 30px 60px -20px rgba(0, 0, 0, 0.3),
      0 14px 32px -8px rgba(0, 0, 0, 0.42),
      0 4px 10px -2px rgba(0, 0, 0, 0.24),
      0 1px 2px 0 rgba(0, 0, 0, 0.24),
      inset 0 1px 0 0 rgba(255, 255, 255, 0.1);
  }
  :global([data-theme='dark']) .wordmark {
    color: var(--color-ink-1);
  }
  :global([data-theme='dark']) .download {
    box-shadow:
      0 1px 2px 0 rgba(0, 0, 0, 0.36),
      0 6px 14px -4px rgba(0, 0, 0, 0.48),
      inset 0 1px 0 0 rgba(255, 255, 255, 0.1);
  }
  :global([data-theme='dark']) .arrow-chip {
    box-shadow: inset 0 0.875px 0 0 rgba(255, 255, 255, 0.1);
  }
  :global([data-theme='dark']) .arrow-chip img {
    filter: brightness(0.4);
  }

  /* ---------- Compact (tablet + mobile) ---------- */
  @media (max-width: 899px) {
    .nav-wrap {
      top: 16px;
    }
    .navbar {
      padding-left: 16px;
    }
    .links,
    .login {
      display: none;
    }
    .navbar {
      grid-template-columns: auto 1fr;
    }
    .right {
      gap: 4px;
    }
  }
  @media (max-width: 420px) {
    .download-app {
      display: none;
    }
  }
</style>
