---
/**
 * Figma "Logo / <Brand>" — a 64×64 logo box. All geometry is in Figma px,
 * multiplied by the inherited --u unit (1px at 100% scale).
 */
import { getImage } from 'astro:assets';
import duolingoPng from '../../assets/images/duolingo.png';
import { brandLogos, type Brand } from './brands';

interface Props {
  brand: Brand;
}
const { brand } = Astro.props;
const duo = brand === 'duolingo' ? await getImage({ src: duolingoPng, width: 400, format: 'webp' }) : null;
---

<span class="logo" aria-hidden="true">
  {brand === 'netflix' && <img class="netflix" src={brandLogos.netflix} alt="" />}
  {brand === 'spotify' && <img class="spotify" src={brandLogos.spotify} alt="" />}
  {brand === 'prime-video' && <img class="prime" src={brandLogos.primeVideo} alt="" />}
  {
    brand === 'hbo-max' && (
      <span class="hbo">
        <img src={brandLogos.hbo} alt="" />
        <span>max</span>
      </span>
    )
  }
  {
    brand === 'duolingo' && duo && (
      <span class="duo">
        <span class="duo-inner">
          <img src={duo.src} alt="" />
        </span>
      </span>
    )
  }
  {brand === 'headspace' && <img class="headspace" src={brandLogos.headspace} alt="" />}
  {
    brand === 'midjourney' && (
      <span class="mj">
        <span class="mj-group">
          <img src={brandLogos.midjourney} alt="" />
        </span>
      </span>
    )
  }
</span>

<style>
  .logo {
    position: absolute;
    left: calc(18 * var(--u));
    top: calc(18 * var(--u));
    width: calc(64 * var(--u));
    height: calc(64 * var(--u));
  }
  .logo img {
    position: absolute;
    max-width: none;
  }
  .netflix {
    left: calc(17 * var(--u));
    top: calc(5 * var(--u));
    width: calc(30.6 * var(--u));
    height: calc(54 * var(--u));
  }
  .spotify {
    left: calc(4 * var(--u));
    top: calc(4 * var(--u));
    width: calc(56 * var(--u));
    height: calc(56 * var(--u));
  }
  .prime {
    left: calc(-6 * var(--u));
    top: calc(19 * var(--u));
    width: calc(76 * var(--u));
    height: calc(28.806 * var(--u));
  }
  .hbo {
    position: absolute;
    left: calc(5 * var(--u));
    top: calc(9 * var(--u));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(1 * var(--u));
  }
  .hbo img {
    position: relative;
    width: calc(54 * var(--u));
    height: calc(22.5 * var(--u));
  }
  .hbo span {
    font-weight: var(--fw-bold);
    font-size: calc(22 * var(--u));
    line-height: calc(22 * var(--u));
    letter-spacing: calc(-0.6 * var(--u));
    color: #fff;
    white-space: nowrap;
  }
  .duo {
    position: absolute;
    left: calc(-18 * var(--u));
    top: calc(-18 * var(--u));
    width: calc(100 * var(--u));
    height: calc(100 * var(--u));
    border-radius: calc(24 * var(--u));
    overflow: hidden;
  }
  .duo-inner {
    position: absolute;
    left: calc(-4 * var(--u));
    top: 0;
    width: calc(108 * var(--u));
    height: calc(100 * var(--u));
    overflow: hidden;
  }
  .duo-inner img {
    width: 133.5%;
    height: 133.52%;
    left: -16.7%;
    top: -15.82%;
  }
  .headspace {
    left: calc(5 * var(--u));
    top: calc(5 * var(--u));
    width: calc(54 * var(--u));
    height: calc(54 * var(--u));
  }
  .mj {
    position: absolute;
    left: calc(-1 * var(--u));
    top: calc(4 * var(--u));
    width: calc(66 * var(--u));
    height: calc(56 * var(--u));
    overflow: hidden;
  }
  .mj-group {
    position: absolute;
    inset: 3.95% 3.61% 5% 3.33%;
  }
  .mj-group img {
    left: -1.62%;
    top: -1.95%;
    width: 103.24%;
    height: 103.9%;
  }
</style>
