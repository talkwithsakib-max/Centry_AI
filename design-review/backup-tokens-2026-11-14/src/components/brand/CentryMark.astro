---
/** CentryAI shield mark (Figma image fill, FIT). */
import { Image } from 'astro:assets';
import mark from '../../assets/images/centry-mark.png';
interface Props {
  size?: number;
  class?: string;
}
const { size = 24, class: className } = Astro.props;
---

<span class:list={['mark', className]} style={`--size:${size}px`} aria-hidden="true">
  <Image src={mark} alt="" width={Math.ceil(size * 2)} densities={[1]} format="webp" loading="eager" />
</span>

<style>
  .mark {
    display: block;
    flex: none;
    width: var(--size);
    height: var(--size);
  }
  .mark :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
